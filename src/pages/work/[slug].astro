---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { mockProjectStories, mockSiteSettings, type MockProjectStory } from '../../data/mock-storyblok';
import { toSiteSettings } from '../../storyblok/mappers';

export function getStaticPaths() {
  return mockProjectStories.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: mockProjectStories[index - 1],
      next: mockProjectStories[index + 1],
    },
  }));
}

interface Props {
  project: MockProjectStory;
  previous?: MockProjectStory;
  next?: MockProjectStory;
}

const { project, previous, next } = Astro.props;
const previousLink = previous ? { title: previous.content.title, href: `/work/${previous.slug}` } : undefined;
const nextLink = next ? { title: next.content.title, href: `/work/${next.slug}` } : undefined;
---

<SiteLayout
  title={`${project.content.title} — Kristel`}
  description={project.content.summary || `${project.content.title} project.`}
  site={toSiteSettings(mockSiteSettings)}
>
  <StoryblokComponent blok={project.content} previous={previousLink} next={nextLink} />
</SiteLayout>
