---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getProjects, getSiteSettings, type PortfolioStory } from '../../storyblok/api';
import { assetUrl } from '../../storyblok/mappers';
import type { ProjectFields } from '../../storyblok/types';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: PortfolioStory<ProjectFields>;
  previous?: PortfolioStory<ProjectFields>;
  next?: PortfolioStory<ProjectFields>;
}

const { project, previous, next } = Astro.props;
const site = await getSiteSettings();
const previousLink = previous ? { title: previous.content.title, href: `/work/${previous.slug}` } : undefined;
const nextLink = next ? { title: next.content.title, href: `/work/${next.slug}` } : undefined;
---

<SiteLayout
  title={project.content.seo_title || `${project.content.title} — Kristel`}
  description={project.content.seo_description || project.content.summary || `${project.content.title} project.`}
  socialImage={assetUrl(project.content.social_image)}
  site={site}
>
  <StoryblokComponent blok={project.content} previous={previousLink} next={nextLink} />
</SiteLayout>
