---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { mockProjectSummaries, mockSiteSettings, mockWorkIndex } from '../../data/mock-storyblok';
import { toSiteSettings } from '../../storyblok/mappers';
---

<SiteLayout
  title={mockWorkIndex.seo_title || 'All work — Kristel'}
  description={mockWorkIndex.seo_description || 'Selected campaign, content, design and event projects.'}
  site={toSiteSettings(mockSiteSettings)}
>
  <StoryblokComponent blok={mockWorkIndex} projects={mockProjectSummaries} />
</SiteLayout>
