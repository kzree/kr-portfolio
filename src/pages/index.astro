---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { mockHome, mockSiteSettings } from '../data/mock-storyblok';
import { toSiteSettings } from '../storyblok/mappers';
---

<SiteLayout
  title={mockHome.seo_title || 'Kristel — Marketing Specialist'}
  description={mockHome.seo_description || 'Ideas into content, campaigns and experiences.'}
  site={toSiteSettings(mockSiteSettings)}
>
  <StoryblokComponent blok={mockHome} />
</SiteLayout>
