---
import type { WritingSummary } from '../lib/content';

interface Props {
  writing: WritingSummary;
}

const { writing } = Astro.props;
---

<article class="min-w-0">
  <a href={writing.url} target="_blank" rel="noopener noreferrer" class="group block rounded-card focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-strong">
    <div class="relative aspect-[1.65] overflow-hidden rounded-card bg-accent-strong">
      {writing.image ? (
        <img src={writing.image.src} alt={writing.image.alt} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 ease-editorial group-hover:scale-[1.04]" />
      ) : (
        <div aria-hidden="true" class="flex h-full items-end p-5 font-display text-card font-semibold tracking-heading text-on-dark">{writing.title}</div>
      )}
    </div>
    <p class="mt-3 text-eyebrow font-semibold tracking-eyebrow text-ink-faint uppercase">{writing.type}</p>
    <h3 class="mt-1 font-display text-card font-bold tracking-heading text-ink group-hover:text-accent-strong">{writing.title}</h3>
    {writing.excerpt && <p class="mt-2 line-clamp-3 text-small text-ink-soft">{writing.excerpt}</p>}
    <span class="mt-3 inline-block text-small font-semibold text-ink">Read article <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
  </a>
</article>
