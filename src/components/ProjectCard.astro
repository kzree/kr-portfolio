---
import type { ProjectSummary } from '../lib/content';

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
---

<article data-project-card data-categories={JSON.stringify(project.categories)} class="min-w-0">
  <a href={`/work/${project.slug}`} class="group block rounded-card focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-strong">
    <div class="relative aspect-[1.12] overflow-hidden rounded-card bg-surface-soft">
      {project.cardImage ? (
        <img src={project.cardImage.src} alt={project.cardImage.alt} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 ease-editorial group-hover:scale-[1.04]" />
      ) : (
        <div aria-hidden="true" class="flex h-full w-full items-end bg-[linear-gradient(135deg,#293c36,#856783_55%,#c69e98)] p-5 text-xl font-bold tracking-heading text-on-dark">
          {project.title}
        </div>
      )}
    </div>
    <h3 class="mt-3 font-display text-card font-bold tracking-heading text-ink group-hover:text-accent-strong">{project.title}</h3>
    <p class="mt-1 text-small text-ink-faint">{project.categories.join(' · ')}</p>
  </a>
</article>
