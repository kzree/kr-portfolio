---
import ProjectCard from './ProjectCard.astro';
import type { ProjectSummary } from '../lib/content';

interface Props {
  projects: ProjectSummary[];
  id?: string;
  columns?: 3 | 4;
}

const { projects, id, columns = 3 } = Astro.props;
---

<div id={id} class:list={['grid grid-cols-1 gap-x-grid gap-y-9 sm:grid-cols-2', columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
  {projects.map((project) => <ProjectCard project={project} />)}
</div>
