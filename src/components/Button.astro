---
interface Props {
  href?: string;
  variant?: 'dark' | 'outline' | 'accent' | 'text';
  type?: 'button' | 'submit';
  external?: boolean;
  download?: boolean;
  class?: string;
}

const { href, variant = 'dark', type = 'button', external = false, download = false, class: className } = Astro.props;
const common = 'inline-flex min-h-10 w-fit items-center justify-center gap-2 rounded-pill px-5 text-small font-medium transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-strong';
const variants = {
  dark: 'bg-ink text-on-dark hover:bg-accent-strong',
  outline: 'border border-ink bg-transparent text-ink hover:bg-surface-soft',
  accent: 'bg-accent text-ink hover:bg-accent-strong hover:text-on-dark',
  text: 'px-0 text-ink hover:text-accent-strong',
};
const classes = [common, variants[variant], className];
---

{href ? (
  <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} download={download || undefined} class:list={classes}><slot /></a>
) : (
  <button type={type} class:list={classes}><slot /></button>
)}
