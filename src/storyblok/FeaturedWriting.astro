---
import { storyblokEditable } from '@storyblok/astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingCard from '../components/WritingCard.astro';
import { isResolved, linkUrl, toWritingSummary } from './mappers';
import type { Block, FeaturedWritingFields } from './types';

interface Props {
  blok: Block<FeaturedWritingFields>;
}

const { blok } = Astro.props;
const entries = (blok.entries ?? []).filter(isResolved).map(toWritingSummary).filter((entry) => entry !== undefined);
const collectionUrl = linkUrl(blok.collection_link);
---

<section {...storyblokEditable(blok)} class="border-t border-line/70 py-section">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Writing" title={blok.heading} />
      {collectionUrl && <Button href={collectionUrl} variant="text" external={blok.collection_link?.linktype === 'url'}>{blok.link_label || 'More writing'} <span aria-hidden="true">↗</span></Button>}
    </div>
    {entries.length > 0 && <div class="mt-8 grid gap-grid sm:grid-cols-2 lg:grid-cols-3">{entries.map((entry) => <WritingCard writing={entry} />)}</div>}
  </Container>
</section>
