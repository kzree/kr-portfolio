---
import { storyblokEditable } from '@storyblok/astro';
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { assetUrl, linkUrl } from './mappers';
import type { Block, HeroFields } from './types';

interface Props {
  blok: Block<HeroFields>;
}

const { blok } = Astro.props;
const portrait = assetUrl(blok.portrait);
const ctaHref = linkUrl(blok.cta_link);
---

<section {...storyblokEditable(blok)}>
  <Container class="grid min-h-[min(43rem,78vh)] gap-10 py-12 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-section">
    <div>
      {blok.eyebrow && <p class="mb-5 text-eyebrow font-semibold tracking-eyebrow text-ink-soft uppercase">{blok.eyebrow}</p>}
      <h1 class="max-w-[16ch] font-display text-hero font-bold tracking-display text-ink uppercase">{blok.headline}</h1>
      {blok.introduction && <p class="mt-7 max-w-[35rem] text-lead text-ink-soft">{blok.introduction}</p>}
      {ctaHref && blok.cta_label && <div class="mt-8"><Button href={ctaHref}>{blok.cta_label} <span aria-hidden="true">↗</span></Button></div>}
    </div>
    <div class="mx-auto w-full max-w-[32rem]">
      <div class="aspect-[0.88] overflow-hidden rounded-card bg-surface-soft">
        {portrait && <OptimizedImage src={portrait} alt={blok.portrait?.alt || 'Portrait of Kristel'} width={900} height={1024} class="h-full w-full object-cover" priority />}
      </div>
    </div>
  </Container>
</section>
